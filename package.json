{
  "name": "@stellix-agency/silt",
  "description": "A declarative, capability-driven component framework for SolidJS.",
  "author": "Stellix Agency — Engineering Team",
  "contributors": [
    {
      "name": "Yanis YOUSFI",
      "email": "y.yousfi@stellix.agency"
    }
  ],
  "version": "1.2.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Stellix-Agency/Silt.git"
  },
  "homepage": "https://github.com/Stellix-Agency/Silt#readme",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build:types": "tsc -p tsconfig.build.json",
    "build": "bun run vite build && bun run build:tokens",
    "dev": "vite",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "solid-js": "^1.9.13",
    "zod": "^4.4.3"
  },
  "keywords": [
    "solidjs",
    "component",
    "library",
    "typescript",
    "stellix"
  ],
  "bugs": {
    "url": "https://github.com/Stellix-Agency/Silt/issues"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "class-variance-authority": "^0.7.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  },
  "files": [
    "dist",
    "scripts"
  ],
  "sideEffects": false
}
